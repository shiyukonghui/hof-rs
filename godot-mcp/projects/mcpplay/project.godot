; Engine configuration file.
; MCP round-7 mini game project (TASK-089 item B).
; Deliberately tiny but real: one scene, one script, a Theme resource, a text
; resource, and a config file. The MCP tools under test are the only thing that
; changes it.

config_version=5

[application]

config/name="McpRound7Mini"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8")
config/description="MCP round-7 mini game (after-run)"

[display]

window/size/viewport_width=800
window/size/viewport_height=600

[dotnet]

project/assembly_name="McpRound7Mini"
