; Engine configuration file.
; C# game template (godot-mcp, TASK-091 / DECISIONS.md D138).
; Instantiate with:  tools\new_game.ps1 -Name <name>
; tetris is replaced by the project name, TetrisGame by the root C# class.

config_version=5

[application]

config/name="tetris"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "C#")
config/description="tetris — C# game (godot-mcp template)"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="tetris"

[input]

