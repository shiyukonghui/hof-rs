<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline restore (TASK-091): only the fork's own SDK/API packages are used.
  The relative path resolves to godot-mcp\godot\bin\GodotSharp\Tools\nupkgs, so the
  project restores with no network at all. NuGet.config paths are relative to
  this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-local" value="..\..\godot\bin\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>
