; Engine configuration file.
; C# game template (godot-mcp, TASK-091 / DECISIONS.md D138).
; Instantiate with:  tools\new_game.ps1 -Name <name>
; missilecommand is replaced by the project name, MissileCommandGame by the root C# class.

config_version=5

[application]

config/name="missilecommand"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "C#")
config/description="missilecommand — C# game (godot-mcp template)"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="missilecommand"

[input]

mc_auto_fire={
"deadzone": 0.2,
"events": [Object(InputEventKey,
"resource_local_to_scene": false,
"resource_name": "",
"device": 16,
"window_id": 0,
"alt_pressed": false,
"shift_pressed": false,
"ctrl_pressed": false,
"meta_pressed": false,
"pressed": true,
"keycode": 32,
"physical_keycode": 0,
"key_label": 0,
"unicode": 0,
"location": 0,
"echo": false,
"script": null
)]
}
