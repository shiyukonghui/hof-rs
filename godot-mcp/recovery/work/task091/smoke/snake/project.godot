; Engine configuration file.
; C# game template (godot-mcp, TASK-091 / DECISIONS.md D138).
; Instantiate with:  tools\new_game.ps1 -Name <name>
; snake is replaced by the project name, SnakeGame by the root C# class.

config_version=5

[application]

config/name="snake"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8")
config/description="snake — C# game (godot-mcp template)"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="snake"
