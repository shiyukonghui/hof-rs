; TASK-096 A: the ownership A/B probe project.
; It is deliberately GDScript-only so that the *same bytes* run on both the
; custom engine and the stock Godot 4.7.1 mono build.
config_version=5

[application]

config/name="task096probe"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/size/mode=0
window/energy_saving/keep_screen_on=false

[rendering]

renderer/rendering_method="forward_plus"
