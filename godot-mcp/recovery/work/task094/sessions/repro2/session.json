{
  "import": false,
  "calls": [
    {"tag": "y01-blue", "port": "game", "tool": "running_game_set_node_property",
     "arguments": {"node_path": "Background", "property": "color", "value": {"a": 1.0, "b": 1.0, "g": 0.0, "r": 0.0}},
     "note": "the background goes pure blue -- no game script writes this node"},

    {"sleep_ms": 500, "port": "game", "note": "let the change be drawn"},

    {"tag": "y02-shot-blue", "port": "game", "tool": "running_game_capture_screenshot",
     "arguments": {"save_path": "user://repro-a.png"}, "note": "picture A: blue"},

    {"tag": "y03-red", "port": "game", "tool": "running_game_set_node_property",
     "arguments": {"node_path": "Background", "property": "color", "value": {"a": 1.0, "b": 0.0, "g": 0.0, "r": 1.0}},
     "note": "and pure red"},

    {"sleep_ms": 500, "port": "game", "note": "let the change be drawn"},

    {"tag": "y04-shot-red", "port": "game", "tool": "running_game_capture_screenshot",
     "arguments": {"save_path": "user://repro-b.png"}, "note": "picture B: red -- must differ from A"},

    {"tag": "y05-green", "port": "game", "tool": "running_game_set_node_property",
     "arguments": {"node_path": "Background", "property": "color", "value": {"a": 1.0, "b": 0.0, "g": 1.0, "r": 0.0}},
     "note": "and pure green"},

    {"sleep_ms": 500, "port": "game", "note": "let the change be drawn"},

    {"tag": "y06-shot-green", "port": "game", "tool": "running_game_capture_screenshot",
     "arguments": {"save_path": "user://repro-c.png"}, "note": "picture C: green -- must differ from both"},

    {"tag": "y07-read-again", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "var c = get_parent().get_node(\"Background\").color\nvar d = get_viewport().get_texture().get_image().get_data()\nvar s = 0\nfor i in range(0, d.size(), 97):\n\ts = (s * 31 + d[i]) % 1000000007\nreturn \"background_color=\" + str(c) + \" readback_sum=\" + str(s) + \" fd=\" + str(Engine.get_frames_drawn())"},
     "note": "the property really is green while the readback says whatever it says"}
  ]
}
