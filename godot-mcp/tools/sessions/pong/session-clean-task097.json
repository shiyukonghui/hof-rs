      "tag": "g05-assert-ball-parked",
      "port": "game",
      "tool": "running_game_assert_node_state",
      "arguments": {
        "node_path": "Ball",
        "property": "position",
        "operator": "eq",
        "expected": {
          "x": 392.0,
          "y": 268.0
        }
      },
      "note": "P-1 fix: the ball is still at the centre after the whole startup window"
    },
    {
      "tag": "g06-serve-and-assert",
      "port": "game",
      "tool": "running_game_run_test_scenario",
      "arguments": {
        "steps": [
          {
            "type": "input",
            "action": "pong_serve",
            "pressed": true
          },
          {
            "type": "wait",
            "seconds": 0.8
          },
          {
            "type": "assert",
            "node_path": "Ball",
            "property": "position",
            "operator": "neq",
            "expected": {
              "x": 392.0,
              "y": 268.0
            }
          }
        ]
      },
      "note": "input -> wait -> assert: serving really starts the ball"
    },
    {
      "tag": "g07-ball-at-t1",
      "port": "game",
      "tool": "running_game_get_node_properties",
      "arguments": {
        "node_path": "Ball",
        "properties": [
          "position",
          "Velocity"
        ]
      },
