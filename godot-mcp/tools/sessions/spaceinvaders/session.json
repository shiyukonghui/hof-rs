{
  "import": true,
  "calls": [
    { "tag": "e01-edit-game", "port": "editor", "tool": "project_edit_script",
      "arguments": { "path": "res://src/SpaceInvadersGame.cs", "content_file": "payload/SpaceInvadersGame.cs" },
      "note": "the whole game is written through the MCP script writer (the template stub is replaced)" },
    { "tag": "e02-open-scene", "port": "editor", "tool": "editor_open_scene",
      "arguments": { "path": "res://scenes/main.tscn" },
      "note": "the template scene already carries the root Main (Node2D) with this script" },
    { "tag": "e03-batch-add-static", "port": "editor", "tool": "editor_add_nodes_batch",
      "arguments": { "nodes": [
          { "type": "ColorRect", "name": "Background", "parent_path": ".", "properties": { "offset_left": 0, "offset_top": 0, "offset_right": 800, "offset_bottom": 600, "color": { "r": 0.03, "g": 0.03, "b": 0.08, "a": 1 } } },
          { "type": "ColorRect", "name": "Player", "parent_path": ".", "properties": { "offset_left": 370, "offset_top": 520, "offset_right": 430, "offset_bottom": 538, "color": { "r": 0.40, "g": 1.0, "b": 0.50, "a": 1 } } },
          { "type": "ColorRect", "name": "Bullet", "parent_path": ".", "properties": { "offset_left": 396, "offset_top": 508, "offset_right": 404, "offset_bottom": 520, "color": { "r": 1.0, "g": 1.0, "b": 0.40, "a": 1 } } },
          { "type": "Label", "name": "Hud", "parent_path": ".", "properties": { "offset_left": 20, "offset_top": 12, "offset_right": 320, "offset_bottom": 60, "text": "SCORE 0", "theme_override_font_sizes/font_size": 28 } },
          { "type": "Label", "name": "Status", "parent_path": ".", "properties": { "offset_left": 470, "offset_top": 12, "offset_right": 780, "offset_bottom": 60, "text": "INVADERS 40", "theme_override_font_sizes/font_size": 22 } }
        ] },
      "note": "the five static nodes of the scene, through the batch tool (invaders are created at run time by the script)" },
    { "tag": "e04-save-1", "port": "editor", "tool": "editor_save_scene",
      "arguments": {},
      "note": "the scene with the five static nodes on disk: sha A" },
    { "tag": "e05-read-1", "port": "editor", "tool": "project_read_text_file",
      "arguments": { "path": "res://scenes/main.tscn" },
      "note": "sha A and the exact bytes" },
    { "tag": "e06-batch-add-static-again", "port": "editor", "tool": "editor_add_nodes_batch",
      "arguments": { "nodes": [
          { "type": "ColorRect", "name": "Background", "parent_path": ".", "properties": { "offset_left": 0, "offset_top": 0, "offset_right": 800, "offset_bottom": 600, "color": { "r": 0.03, "g": 0.03, "b": 0.08, "a": 1 } } },
          { "type": "ColorRect", "name": "Player", "parent_path": ".", "properties": { "offset_left": 370, "offset_top": 520, "offset_right": 430, "offset_bottom": 538, "color": { "r": 0.40, "g": 1.0, "b": 0.50, "a": 1 } } },
          { "type": "ColorRect", "name": "Bullet", "parent_path": ".", "properties": { "offset_left": 396, "offset_top": 508, "offset_right": 404, "offset_bottom": 520, "color": { "r": 1.0, "g": 1.0, "b": 0.40, "a": 1 } } },
          { "type": "Label", "name": "Hud", "parent_path": ".", "properties": { "offset_left": 20, "offset_top": 12, "offset_right": 320, "offset_bottom": 60, "text": "SCORE 0", "theme_override_font_sizes/font_size": 28 } },
          { "type": "Label", "name": "Status", "parent_path": ".", "properties": { "offset_left": 470, "offset_top": 12, "offset_right": 780, "offset_bottom": 60, "text": "INVADERS 40", "theme_override_font_sizes/font_size": 22 } }
        ] },
      "note": "REAL-DEVELOPMENT PROOF of the TASK-097 fix: the same batch a second time (the exact mistake that polluted pong/breakout/snake) must be REFUSED with -32000 + data.conflicts, and must not leave a single @ColorRect@* copy behind" },
    { "tag": "e07-tree-after-refusal", "port": "editor", "tool": "editor_get_scene_tree",
      "arguments": {},
      "note": "the tree after the refusal: Main + the five named nodes, no automatic name" },
    { "tag": "e08-save-2", "port": "editor", "tool": "editor_save_scene",
      "arguments": {},
      "note": "saving after the refusal must reproduce the same file" },
    { "tag": "e09-read-2", "port": "editor", "tool": "project_read_text_file",
      "arguments": { "path": "res://scenes/main.tscn" },
      "note": "sha B; A == B is the proof that the refused batch wrote nothing" },
    { "tag": "e10-action-left", "port": "editor", "tool": "editor_add_input_action",
      "arguments": { "action": "si_left", "key": "A" },
      "note": "one of the two player actions the game polls" },
    { "tag": "e11-action-right", "port": "editor", "tool": "editor_add_input_action",
      "arguments": { "action": "si_right", "key": "D" },
      "note": "the other one" },
    { "tag": "e12-action-fire", "port": "editor", "tool": "editor_add_input_action",
      "arguments": { "action": "si_fire", "key": "Space" },
      "note": "declared even though the deterministic tests fire through the hook" },
    { "tag": "e13-build-csharp", "port": "editor", "tool": "project_build_csharp",
      "arguments": { "configuration": "Debug", "timeout_ms": 300000, "rescan": true },
      "note": "compile the game that the MCP script writer just wrote" },
    { "tag": "e14-validate-scripts", "port": "editor", "tool": "project_validate_scripts",
      "arguments": { "paths": [ "res://src/SpaceInvadersGame.cs" ] },
      "note": "the engine's own per-file verdict" },
    { "tag": "e15-errors", "port": "editor", "tool": "editor_get_errors",
      "arguments": {},
      "note": "the editor log's ERROR lines after the build" },

    { "tag": "g01-scene-tree", "port": "game", "tool": "running_game_get_scene_tree",
      "arguments": {},
      "note": "the running tree: the five static nodes plus the 40 invaders the script created at run time" },
    { "tag": "g02-readback-t0", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().Dump()" },
      "note": "the whole state as one line" },
    { "tag": "g03-assert-score-0", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "Score", "operator": "eq", "expected": 0 },
      "note": "nothing has scored yet" },
    { "tag": "g04-assert-remaining-40", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "InvadersRemaining", "operator": "eq", "expected": 40 },
      "note": "5 rows x 8 columns of invaders are alive" },
    { "tag": "g05-assert-not-over", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "GameOver", "operator": "eq", "expected": false },
      "note": "the game starts alive" },
    { "tag": "g06-shot-t0", "port": "game", "tool": "running_game_capture_screenshot",
      "arguments": { "save_path": "user://si-t0.png" },
      "note": "the first frame of the evidence pair chain" },
    { "tag": "g07-samples-frozen", "port": "game", "tool": "running_game_get_node_property_samples",
      "arguments": { "node_path": "Main", "properties": ["WaveX", "WaveY", "Ticks"], "frame_count": 12, "frame_interval": 1 },
      "note": "determinism baseline: with StepInterval 0 the wave does NOT move while the clock runs (WaveX constant, Ticks increasing)" },
    { "tag": "g08-wave-speed-on", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().SetWaveSpeed(0.05)" },
      "note": "the one test that watches the wave move asks for motion explicitly" },
    { "tag": "g09-samples-moving", "port": "game", "tool": "running_game_get_node_property_samples",
      "arguments": { "node_path": "Main", "properties": ["WaveX", "WaveSteps"], "frame_count": 30, "frame_interval": 1 },
      "note": "multi-frame property sample of the moving wave" },
    { "tag": "g10-assert-stepped", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "WaveSteps", "operator": "gt", "expected": 0 },
      "note": "the wave really stepped" },
    { "tag": "g11-wave-speed-off", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().SetWaveSpeed(0.0)" },
      "note": "back to frozen, so the next aim and its readback are the same fact" },
    { "tag": "g12-force-all", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().ForceTestState(\"wave=140,90,1\")" },
      "note": "pin the whole state: 40 alive, frozen, player at 370" },
    { "tag": "g13-fire-test-bullet", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().FireTestBullet(0,0)" },
      "note": "aim deterministically: a bullet 30 px below the centre of invader (0,0)" },
    { "tag": "g14-samples-flight", "port": "game", "tool": "running_game_get_node_property_samples",
      "arguments": { "node_path": "Main", "properties": ["BulletY", "BulletActive", "Score", "InvadersRemaining"], "frame_count": 14, "frame_interval": 1 },
      "note": "the flight frame by frame, ending on the kill it caused" },
    { "tag": "g15-assert-score-10", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "Score", "operator": "eq", "expected": 10 },
      "note": "one kill = 10 points" },
    { "tag": "g16-assert-remaining-39", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "InvadersRemaining", "operator": "eq", "expected": 39 },
      "note": "the grid lost exactly one invader" },
    { "tag": "g17-assert-killed-1", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "InvadersKilled", "operator": "eq", "expected": 1 },
      "note": "the kill counter agrees with the grid" },
    { "tag": "g18-shot-t1", "port": "game", "tool": "running_game_capture_screenshot",
      "arguments": { "save_path": "user://si-t1.png" },
      "note": "after the kill: one invader is gone from the picture" },
    { "tag": "g19-force-one-left", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().ForceTestState(\"alive=4,7;wave=140,90,1\")" },
      "note": "pin a one-invader wave, so 'the last kill ends the game' is a single deterministic step" },
    { "tag": "g20-assert-remaining-1", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "InvadersRemaining", "operator": "eq", "expected": 1 },
      "note": "the forced state really is one invader" },
    { "tag": "g21-fire-last", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().FireTestBullet(4,7)" },
      "note": "aim at the last one" },
    { "tag": "g22-sleep-after-last-kill", "port": "game", "sleep_ms": 600,
      "note": "let the bullet travel and the kill land" },
    { "tag": "g23-assert-won", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "Won", "operator": "eq", "expected": true },
      "note": "clearing the wave is a win" },
    { "tag": "g24-assert-over-by-win", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "GameOver", "operator": "eq", "expected": true },
      "note": "and it ends the game" },
    { "tag": "g25-readback-won", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().Dump()" },
      "note": "the whole state at the win: grid all dots, done=true, won=true, score=10" },
    { "tag": "g26-shot-t2-won", "port": "game", "tool": "running_game_capture_screenshot",
      "arguments": { "save_path": "user://si-t2.png" },
      "note": "the win screen: no invaders at all, the status label says WAVE CLEARED" },
    { "tag": "g27-assert-screen-text-hit", "port": "game", "tool": "running_game_assert_screen_text",
      "arguments": { "text": "WAVE CLEARED" },
      "note": "the status label really is on the captured screen" },
    { "tag": "g28-force-lost", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().ForceTestState(\"wave=140,520,1\")" },
      "note": "pin a wave at the player's row: the loss condition is a property of WaveY" },
    { "tag": "g29-sleep-lost", "port": "game", "sleep_ms": 400,
      "note": "one frame is enough, but the readback is taken after the clock has moved" },
    { "tag": "g30-assert-over-by-loss", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "GameOver", "operator": "eq", "expected": true },
      "note": "the invaders reached the player" },
    { "tag": "g31-assert-not-won", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "Main", "property": "Won", "operator": "eq", "expected": false },
      "note": "a loss is not a win" },
    { "tag": "g32-readback-lost", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().Dump()" },
      "note": "the whole state at the loss" },
    { "tag": "g33-shot-t3-lost", "port": "game", "tool": "running_game_capture_screenshot",
      "arguments": { "save_path": "user://si-t3.png" },
      "note": "the loss screen: the wave is at the bottom row" },
    { "tag": "g34-assert-screen-text-lost", "port": "game", "tool": "running_game_assert_screen_text",
      "arguments": { "text": "GAME OVER" },
      "note": "the status label says GAME OVER on the captured screen" },
    { "tag": "g35-runtime-overlay", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "var main = get_parent()\nvar c = ColorRect.new()\nc.name = StringName(\"ProbeOverlay\")\nc.position = Vector2(20, 540)\nc.size = Vector2(120, 40)\nc.color = Color(0.1, 0.9, 0.95, 1.0)\nmain.add_child(c)\nreturn \"overlay added\" " },
      "note": "a node created at run time, in the same session, as the positive control for 'a run-time node is drawn' (and the invaders are 40 of those)" },
    { "tag": "g36-shot-t4-overlay", "port": "game", "tool": "running_game_capture_screenshot",
      "arguments": { "save_path": "user://si-t4.png" },
      "note": "the overlay is visible in this frame and not in t3" },
    { "tag": "g37-assert-overlay", "port": "game", "tool": "running_game_assert_node_state",
      "arguments": { "node_path": "ProbeOverlay", "property": "visible", "operator": "eq", "expected": true },
      "note": "the run-time node is in the tree" },
    { "tag": "g38-samples-overlay", "port": "game", "tool": "running_game_get_node_property_samples",
      "arguments": { "node_path": "ProbeOverlay", "properties": ["position", "size", "color"], "frame_count": 10, "frame_interval": 1 },
      "note": "frame-by-frame sample of the run-time node" },
    { "tag": "g39-force-for-input", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "get_parent().ForceTestState(\"wave=140,90,1\")\nreturn get_parent().SetPollInput(true)" },
      "note": "the player ignores input unless a test asks (determinism rule)" },
    { "tag": "g40-player-right", "port": "game", "tool": "running_game_run_test_scenario",
      "arguments": { "steps": [
          { "type": "input", "action": "si_right", "pressed": true },
          { "type": "wait", "seconds": 0.4 },
          { "type": "assert", "node_path": "Main", "property": "PlayerX", "operator": "gt", "expected": 370 }
        ] },
      "note": "the player really moves on the declared action" },
    { "tag": "g41-player-left-back", "port": "game", "tool": "running_game_run_test_scenario",
      "arguments": { "steps": [
          { "type": "input", "action": "si_left", "pressed": true },
          { "type": "wait", "seconds": 0.4 },
          { "type": "assert", "node_path": "Main", "property": "PlayerX", "operator": "lt", "expected": 780 }
        ] },
      "note": "and moves back" },
    { "tag": "g42-stress", "port": "game", "tool": "running_game_run_stress_test",
      "arguments": { "action": "si_left", "count": 10 },
      "note": "the driver's stress shape over the same action" },
    { "tag": "g43-input-off", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().SetPollInput(false)" },
      "note": "polling off again: nothing after this can drift because a key stayed pressed" },
    { "tag": "g44-final-samples", "port": "game", "tool": "running_game_get_node_property_samples",
      "arguments": { "node_path": "Main", "properties": ["Score", "InvadersRemaining", "GameOver", "Ticks"], "frame_count": 12, "frame_interval": 1 },
      "note": "the final multi-frame sample" },
    { "tag": "g45-final-readback", "port": "game", "tool": "running_game_execute_gdscript",
      "arguments": { "code": "return get_parent().Dump()" },
      "note": "the final state as one line" },
    { "tag": "g46-final-tree", "port": "game", "tool": "running_game_get_scene_tree",
      "arguments": {},
      "note": "the final tree, including the run-time overlay and the 40 invader nodes" }
  ]
}
