{
  "_comment": "TASK-096 item C -- the Tetris development session, replayed through the MCP endpoints. Every project file this game consists of is written by an MCP call (project_create_script / project_edit_script / editor_add_nodes_batch / editor_save_scene), never by the shell. The C# payloads live next to this file in payload/ and are resolved by the driver's content_file. The five input actions are declared by editor_add_input_action. The scene is built ONCE: re-running editor_add_nodes_batch on a scene that already has these nodes is what polluted the three older games (see D-1).",
  "game": "tetris",
  "import": true,
  "calls": [
    {"tag": "e01-tools-list", "port": "editor", "method": "tools/list", "note": "the editor contract"},

    {"tag": "e02-create-tetromino", "port": "editor", "tool": "project_create_script",
     "arguments": {"path": "res://src/Tetromino.cs", "content_file": "payload/Tetromino.cs"},
     "note": "MCP writes the authored shape table (one file, one call)"},
    {"tag": "e03-edit-game", "port": "editor", "tool": "project_edit_script",
     "arguments": {"path": "res://src/TetrisGame.cs", "content_file": "payload/TetrisGame.cs"},
     "note": "MCP rewrites the template's root script into the real game"},

    {"tag": "e04-build-csharp", "port": "editor", "tool": "project_build_csharp",
     "arguments": {"configuration": "Debug", "timeout_ms": 300000, "rescan": true},
     "note": "the .NET build, driven by MCP"},

    {"tag": "e05-validate-scripts", "port": "editor", "tool": "project_validate_scripts",
     "arguments": {"paths": ["res://src/Tetromino.cs", "res://src/TetrisGame.cs"]},
     "note": "per-file verdict for the two scripts"},

    {"tag": "e06-open-scene", "port": "editor", "tool": "editor_open_scene",
     "arguments": {"path": "res://scenes/main.tscn"}, "note": "open the template scene (it holds Main and nothing else)"},

    {"tag": "e07-add-nodes", "port": "editor", "tool": "editor_add_nodes_batch",
     "arguments": {"resolve_within_batch": false, "nodes": [
        {"type": "ColorRect", "name": "SidePanel", "parent_path": ".",
         "properties": {"offset_left": 20.0, "offset_top": 40.0, "offset_right": 260.0, "offset_bottom": 520.0,
                        "color": {"r": 0.09, "g": 0.10, "b": 0.16, "a": 1.0}}},
        {"type": "ColorRect", "name": "PanelEdge", "parent_path": ".",
         "properties": {"offset_left": 258.0, "offset_top": 40.0, "offset_right": 260.0, "offset_bottom": 520.0,
                        "color": {"r": 0.25, "g": 0.45, "b": 0.75, "a": 1.0}}},
        {"type": "Label", "name": "HudLabel", "parent_path": ".",
         "properties": {"offset_left": 32.0, "offset_top": 60.0, "offset_right": 250.0, "offset_bottom": 300.0,
                        "text": "TETRIS", "visible": true}},
        {"type": "ColorRect", "name": "StatusOverlay", "parent_path": ".",
         "properties": {"offset_left": 0.0, "offset_top": 0.0, "offset_right": 800.0, "offset_bottom": 600.0,
                        "color": {"r": 0.90, "g": 0.20, "b": 0.20, "a": 0.35},
                        "visible": false}}
     ]},
     "note": "MCP builds the whole scene: 4 nodes (side panel, its edge, the HUD label, the game-over overlay). The playfield is drawn by TetrisGame._Draw, so no full-screen node may sit above it"},

    {"tag": "e08-hud-text", "port": "editor", "tool": "editor_set_node_property",
     "arguments": {"path": "HudLabel", "property": "text", "value": "TETRIS 10x20"},
     "note": "the HUD text is authored by MCP, not by the script"},

    {"tag": "e09-action-left", "port": "editor", "tool": "editor_add_input_action",
     "arguments": {"action": "tetris_left", "key": "A"}, "note": "declare the action (a game's job, not the tool's)"},
    {"tag": "e10-action-right", "port": "editor", "tool": "editor_add_input_action",
     "arguments": {"action": "tetris_right", "key": "D"}, "note": "declare the action"},
    {"tag": "e11-action-rotate", "port": "editor", "tool": "editor_add_input_action",
     "arguments": {"action": "tetris_rotate", "key": "W"}, "note": "declare the action"},
    {"tag": "e12-action-down", "port": "editor", "tool": "editor_add_input_action",
     "arguments": {"action": "tetris_down", "key": "S"}, "note": "declare the action"},
    {"tag": "e13-action-drop", "port": "editor", "tool": "editor_add_input_action",
     "arguments": {"action": "tetris_drop", "key": "E"}, "note": "declare the hard-drop action"},

    {"tag": "e14-save-scene", "port": "editor", "tool": "editor_save_scene",
     "arguments": {}, "note": "write scenes/main.tscn exactly once"},
    {"tag": "e15-scene-tree", "port": "editor", "tool": "editor_get_scene_tree",
     "arguments": {}, "note": "read the scene back (file change)"},
    {"tag": "e16-validate-after", "port": "editor", "tool": "project_validate_scripts",
     "arguments": {}, "note": "whole-project script validation after the scene edit"},
    {"tag": "e17-screenshot", "port": "editor", "tool": "editor_capture_screenshot",
     "arguments": {"save_path": "user://tetris-editor.png"}, "note": "the editor view of the scene (file change)"},
    {"tag": "e18-errors", "port": "editor", "tool": "editor_get_errors",
     "arguments": {}, "note": "editor log read"},

    {"tag": "g01-scene-tree", "port": "game", "tool": "running_game_get_scene_tree",
     "arguments": {}, "note": "the running tree at t0"},
    {"tag": "g02-readback-t0", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "return get_parent().Dump()"},
     "note": "the whole board in one read at t0"},
    {"tag": "g03-assert-score-0", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "Main", "property": "Score", "operator": "eq", "expected": 0},
     "note": "a fresh board scores nothing"},
    {"tag": "g04-assert-not-over", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "Main", "property": "GameOver", "operator": "eq", "expected": false},
     "note": "and is not over"},

    {"tag": "g05-shot-t0", "port": "game", "tool": "running_game_capture_screenshot",
     "arguments": {"save_path": "user://tetris-t0.png"}, "note": "frame at t0"},

    {"tag": "g06-samples-gravity-off", "port": "game", "tool": "running_game_get_node_property_samples",
     "arguments": {"node_path": "Main", "properties": ["PieceY", "PieceX", "FilledCells"], "frame_count": 10, "frame_interval": 1},
     "note": "frame-by-frame proof of the determinism rule: with gravity off the piece does not move on its own"},

    {"tag": "g07-gravity-on", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "return get_parent().SetGravity(0.05)"},
     "note": "test hook: turn gravity on, 20 steps a second"},
    {"tag": "g08-samples-falling", "port": "game", "tool": "running_game_get_node_property_samples",
     "arguments": {"node_path": "Main", "properties": ["PieceY", "Ticks"], "frame_count": 30, "frame_interval": 1},
     "note": "the falling piece, sampled once per frame (gravity ON)"},
    {"tag": "g09-assert-fell", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "Main", "property": "PieceY", "operator": "gt", "expected": 0},
     "note": "and it really moved"},
    {"tag": "g10-gravity-off", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "return get_parent().SetGravity(0.0)"},
     "note": "freeze gravity again before the deterministic hooks"},

    {"tag": "g11-aim-piece", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "return get_parent().ForceTestState(\"piece=0;x=3;y=0;rot=0;board=..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........\")"},
     "note": "test hook: I-piece at 3,0 on an empty board"},
    {"tag": "g12-move-right", "port": "game", "tool": "running_game_run_test_scenario",
     "arguments": {"steps": [
        {"type": "input", "action": "tetris_right", "pressed": true},
        {"type": "assert", "node_path": "Main", "property": "PieceX", "operator": "eq", "expected": 4}
     ]}, "note": "input -> assert: one press moves the piece exactly one column"},
    {"tag": "g13-move-left", "port": "game", "tool": "running_game_run_test_scenario",
     "arguments": {"steps": [
        {"type": "input", "action": "tetris_left", "pressed": true},
        {"type": "assert", "node_path": "Main", "property": "PieceX", "operator": "eq", "expected": 3}
     ]}, "note": "and back"},
    {"tag": "g14-rotate", "port": "game", "tool": "running_game_run_test_scenario",
     "arguments": {"steps": [
        {"type": "input", "action": "tetris_rotate", "pressed": true},
        {"type": "assert", "node_path": "Main", "property": "PieceRot", "operator": "eq", "expected": 1}
     ]}, "note": "rotation is a state change, not a log line"},
    {"tag": "g15-piece-cells", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "var m = get_parent()\nreturn \"cells=[\" + m.PieceCells() + \"] rot=\" + str(m.PieceRot) + \" at=\" + str(m.PieceX) + \",\" + str(m.PieceY)"},
     "note": "the four occupied cells of the rotated piece, read from the game"},
    {"tag": "g16-boundary-unknown-property", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "Main", "property": "NotAProperty", "operator": "eq", "expected": 1},
     "note": "BOUNDARY CALL: asserting a property that does not exist -- the declared failure path"},
    {"tag": "g17-shot-t1-rotated", "port": "game", "tool": "running_game_capture_screenshot",
     "arguments": {"save_path": "user://tetris-t1.png"}, "note": "before/after pair with g05 (the piece changed shape and cell)"},

    {"tag": "g18-aim-line-clear", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "return get_parent().ForceTestState(\"piece=1;x=7;y=18;rot=0;board=..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|########..\")"},
     "note": "test hook: the bottom row has 8 of 10 cells filled and an O-piece rests on the two holes"},
    {"tag": "g19-assert-aim", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "Main", "property": "PieceX", "operator": "eq", "expected": 7},
     "note": "the piece really is where the test put it"},
    {"tag": "g20-assert-filled", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "Main", "property": "FilledCells", "operator": "eq", "expected": 8},
     "note": "and the playfield really holds those 8 cells"},
    {"tag": "g21-harddrop-clear", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "return get_parent().HardDrop()"},
     "note": "the drop locks the O onto the two holes, which completes the row"},
    {"tag": "g22-assert-lines", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "Main", "property": "Lines", "operator": "eq", "expected": 1},
     "note": "exactly one line went"},
    {"tag": "g23-assert-score", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "Main", "property": "Score", "operator": "eq", "expected": 100},
     "note": "and it scored exactly what one line is worth (no drop points)"},
    {"tag": "g24-readback-cleared", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "return get_parent().Dump()"},
     "note": "the board after the clear: two cells left over from the O, the bottom row gone"},
    {"tag": "g25-shot-t2-cleared", "port": "game", "tool": "running_game_capture_screenshot",
     "arguments": {"save_path": "user://tetris-t2.png"}, "note": "before/after pair with g17"},

    {"tag": "g26-aim-gameover", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "return get_parent().ForceTestState(\"piece=1;x=7;y=18;rot=0;board=....##....|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........|..........\")"},
     "note": "test hook: the two cells the next O-piece is born on (4,0) and (5,0) are already occupied, and the row is NOT full (so no line clear can rescue it) -- the spawn must end the game. Defect T-3 of the first round: a FULL spawn row was used, the line clear ran before the spawn check, and the game correctly refused to end"},
    {"tag": "g27-harddrop-gameover", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "return get_parent().HardDrop()"},
     "note": "lock the piece, then the spawn is blocked"},
    {"tag": "g28-assert-over", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "Main", "property": "GameOver", "operator": "eq", "expected": true},
     "note": "the game is over"},
    {"tag": "g29-readback-over", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "var m = get_parent()\nreturn \"over=\" + str(m.GameOver) + \" score=\" + str(m.Score) + \" lines=\" + str(m.Lines) + \" filled=\" + str(m.FilledCells) + \" hash=\" + str(m.BoardHash) + \" event=\" + str(m.LastEvent)"},
     "note": "why it ended, in the game's own words"},

    {"tag": "g30-runtime-overlay", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "var main = get_parent()\nvar c = ColorRect.new()\nc.name = StringName(\"ProbeOverlay\")\nc.position = Vector2(20, 540)\nc.size = Vector2(120, 40)\nc.color = Color(0.1, 0.9, 0.9, 1)\nmain.add_child(c)\nreturn \"overlay \" + str(c.get_path()) + \" at \" + str(c.position)"},
     "note": "VISUAL CONTROL: a canvas item created at run time, drawn on top of everything -- if the pixels move for this one but not for the board, the readback path is the suspect"},
    {"tag": "g31-shot-t3-overlay", "port": "game", "tool": "running_game_capture_screenshot",
     "arguments": {"save_path": "user://tetris-t3.png"}, "note": "before/after pair with g25 (a run-time node appeared)"},
    {"tag": "g32-overlay-samples", "port": "game", "tool": "running_game_get_node_property_samples",
     "arguments": {"node_path": "ProbeOverlay", "properties": ["position", "color"], "frame_count": 10, "frame_interval": 1},
     "note": "the run-time node really exists in the tree, frame after frame"},

    {"tag": "g33-stress", "port": "game", "tool": "running_game_run_stress_test",
     "arguments": {"action": "tetris_right", "count": 10}, "note": "repeated input under the game-over state"},
    {"tag": "g34-final-samples", "port": "game", "tool": "running_game_get_node_property_samples",
     "arguments": {"node_path": "Main", "properties": ["Score", "Lines", "GameOver", "FilledCells"], "frame_count": 12, "frame_interval": 1},
     "note": "the finished state, sampled"},
    {"tag": "g35-final-readback", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "return get_parent().Dump()"},
     "note": "one composite read of the finished state"},
    {"tag": "g36-scene-tree-final", "port": "game", "tool": "running_game_get_scene_tree",
     "arguments": {}, "note": "the tree at the end (it must be the tree we built plus the run-time overlay)"}
  ]
}
