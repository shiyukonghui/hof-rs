{
  "_comment": "TASK-093 item A -- the Snake development session, replayed through the MCP endpoints. Every project file this game consists of is written by an MCP call (project_create_script / project_edit_script / editor_add_nodes_batch / editor_save_scene), never by the shell. The C# payloads live next to this file in payload/ and are resolved by the driver's content_file. The four input actions are declared by editor_add_input_action.",
  "game": "snake",
  "import": true,
  "calls": [
    {"tag": "e01-tools-list", "port": "editor", "method": "tools/list", "note": "the editor contract"},

    {"tag": "e02-create-segment", "port": "editor", "tool": "project_create_script",
     "arguments": {"path": "res://src/SnakeSegment.cs", "content_file": "payload/SnakeSegment.cs"},
     "note": "MCP writes the segment script"},
    {"tag": "e03-create-food", "port": "editor", "tool": "project_create_script",
     "arguments": {"path": "res://src/Food.cs", "content_file": "payload/Food.cs"},
     "note": "MCP writes the food script"},
    {"tag": "e04-edit-game", "port": "editor", "tool": "project_edit_script",
     "arguments": {"path": "res://src/SnakeGame.cs", "content_file": "payload/SnakeGame.cs"},
     "note": "MCP rewrites the template's root script into the real game"},

    {"tag": "e05-build-csharp", "port": "editor", "tool": "project_build_csharp",
     "arguments": {"configuration": "Debug", "timeout_ms": 300000, "rescan": true},
     "note": "the .NET build, driven by MCP"},

    {"tag": "e06-validate-scripts", "port": "editor", "tool": "project_validate_scripts",
     "arguments": {"paths": ["res://src/SnakeSegment.cs", "res://src/Food.cs", "res://src/SnakeGame.cs"]},
     "note": "per-file verdict for the three scripts"},

