     "note": "MCP builds the whole scene: 40 nodes (background, 14 grid lines, a 20-segment pool, food, the status overlay)"},

    {"tag": "e09-script-segments", "port": "editor", "tool": "editor_set_node_script_batch",
     "arguments": {"node_paths": ["SnakeSeg00", "SnakeSeg01", "SnakeSeg02", "SnakeSeg03", "SnakeSeg04",
                                  "SnakeSeg05", "SnakeSeg06", "SnakeSeg07", "SnakeSeg08", "SnakeSeg09",
                                  "SnakeSeg10", "SnakeSeg11", "SnakeSeg12", "SnakeSeg13", "SnakeSeg14",
                                  "SnakeSeg15", "SnakeSeg16", "SnakeSeg17", "SnakeSeg18", "SnakeSeg19"],
                   "script_path": "res://src/SnakeSegment.cs"},
     "note": "attach SnakeSegment.cs to the whole pool in one call"},
    {"tag": "e10-script-food", "port": "editor", "tool": "editor_set_node_script_batch",
     "arguments": {"node_paths": ["Food"], "script_path": "res://src/Food.cs"},
     "note": "attach Food.cs"},

    {"tag": "e11-action-up", "port": "editor", "tool": "editor_add_input_action",
     "arguments": {"action": "snake_up", "key": "W"}, "note": "declare the action (a game's job, not the tool's)"},
    {"tag": "e12-action-down", "port": "editor", "tool": "editor_add_input_action",
     "arguments": {"action": "snake_down", "key": "S"}, "note": "declare the action"},
    {"tag": "e13-action-left", "port": "editor", "tool": "editor_add_input_action",
     "arguments": {"action": "snake_left", "key": "A"}, "note": "declare the action"},
    {"tag": "e14-action-right", "port": "editor", "tool": "editor_add_input_action",
     "arguments": {"action": "snake_right", "key": "D"}, "note": "declare the action"},
    {"tag": "e15-action-pause", "port": "editor", "tool": "editor_add_input_action",
     "arguments": {"action": "snake_pause", "key": "P"}, "note": "declare the pause action"},

    {"tag": "e16-save-scene", "port": "editor", "tool": "editor_save_scene",
     "arguments": {}, "note": "write scenes/main.tscn"},
    {"tag": "e17-scene-tree", "port": "editor", "tool": "editor_get_scene_tree",
     "arguments": {}, "note": "read the scene back (file change)"},
    {"tag": "e18-food-properties", "port": "editor", "tool": "editor_get_node_properties",
     "arguments": {"path": "Food", "properties": ["position", "size", "color", "CellX", "CellY"]},
     "note": "read the pellet's authored properties"},
    {"tag": "e19-validate-after", "port": "editor", "tool": "project_validate_scripts",
     "arguments": {}, "note": "whole-project script validation after the scene edit"},
    {"tag": "e20-screenshot", "port": "editor", "tool": "editor_capture_screenshot",
     "arguments": {"save_path": "user://snake-editor.png"}, "note": "the editor view of the scene (file change)"},
    {"tag": "e21-errors", "port": "editor", "tool": "editor_get_errors",
     "arguments": {}, "note": "editor log read"},

    {"tag": "g01-scene-tree", "port": "game", "tool": "running_game_get_scene_tree",
     "arguments": {}, "note": "the running tree at t0"},
    {"tag": "g02-readback-t0", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "var m = get_parent()\nreturn \"head=\" + str(m.HeadX) + \",\" + str(m.HeadY) + \" dir=\" + str(m.DirectionX) + \",\" + str(m.DirectionY) + \" len=\" + str(m.Length) + \" score=\" + str(m.Score) + \" food=\" + str(m.get_node(\"Food\").CellX) + \",\" + str(m.get_node(\"Food\").CellY) + \" over=\" + str(m.GameOver)"},
     "note": "the whole board in one read at t0"},

    {"tag": "g03-shot-t0", "port": "game", "tool": "running_game_capture_screenshot",
     "arguments": {"save_path": "user://snake-t0.png"}, "note": "frame at t0 (before the snake is aimed anywhere)"},

    {"tag": "g04-park-check-must-fail", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "SnakeSeg00", "property": "position", "operator": "eq",
                   "expected": {"x": 120.0, "y": 240.0}},
     "note": "MUST fail: the snake has already stepped during the startup window, so its head is no longer at the authored cell -- the assertion is not rubber-stamping"},

    {"tag": "g05-aim-pause", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "var m = get_parent()\nreturn m.ForceTestState(\"8,10|7,10|6,10;dir=1,0;food=0,0\")"},
     "note": "test hook: a known board before the pause test, so the snake cannot have died during the startup window"},

    {"tag": "g06-pause", "port": "game", "tool": "running_game_run_test_scenario",
     "arguments": {"steps": [
        {"type": "input", "action": "snake_pause", "pressed": true},
        {"type": "wait", "seconds": 0.6},
        {"type": "assert", "node_path": "Main", "property": "Paused", "operator": "eq", "expected": true},
        {"type": "assert", "node_path": "Main", "property": "GameOver", "operator": "eq", "expected": false}
     ]}, "note": "input -> wait -> assert: the pause action really stops the snake"},

    {"tag": "g07-head-frozen", "port": "game", "tool": "running_game_get_node_property_samples",
     "arguments": {"node_path": "SnakeSeg00", "properties": ["position"], "frame_count": 30, "frame_interval": 1},
     "note": "frame-by-frame proof that a paused snake does not move (30 frames)"},

    {"tag": "g08-unpause", "port": "game", "tool": "running_game_run_test_scenario",
     "arguments": {"steps": [
        {"type": "input", "action": "snake_pause", "pressed": true},
        {"type": "wait", "seconds": 1.0},
        {"type": "assert", "node_path": "Main", "property": "Paused", "operator": "eq", "expected": false},
        {"type": "assert", "node_path": "Main", "property": "HeadX", "operator": "gt", "expected": 8}
     ]}, "note": "input -> wait -> assert: unpausing really resumes the snake (the head is past where it was aimed)"},

    {"tag": "g09-shot-t1-moving", "port": "game", "tool": "running_game_capture_screenshot",
     "arguments": {"save_path": "user://snake-t1.png"}, "note": "frame after a second of free travel (pixels must differ from t0)"},

    {"tag": "g10-motion-samples", "port": "game", "tool": "running_game_get_node_property_samples",
     "arguments": {"node_path": "SnakeSeg00", "properties": ["position"], "frame_count": 45, "frame_interval": 1},
     "note": "frame-by-frame proof that the snake travels on the grid while nothing is injected"},

    {"tag": "g11-readback-t1", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "var m = get_parent()\nreturn \"head=\" + str(m.HeadX) + \",\" + str(m.HeadY) + \" len=\" + str(m.Length) + \" score=\" + str(m.Score) + \" over=\" + str(m.GameOver) + \" reason=\" + str(m.LoseReason) + \" ticks=\" + str(m.Ticks)"},
     "note": "the board after a second of free travel"},

    {"tag": "g12-aim-growth", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "var m = get_parent()\nreturn m.ForceTestState(\"8,10|7,10|6,10;dir=1,0;food=9,10\")"},
     "note": "test hook: head at 8,10 heading right with the pellet pinned one cell ahead at 9,10"},
    {"tag": "g13-assert-food-ahead", "port": "game", "tool": "running_game_assert_node_state",
     "arguments": {"node_path": "Food", "property": "CellX", "operator": "eq", "expected": 9},
     "note": "the pellet really is where the test put it"},
    {"tag": "g14-growth", "port": "game", "tool": "running_game_run_test_scenario",
     "arguments": {"steps": [
        {"type": "wait", "seconds": 0.6},
        {"type": "assert", "node_path": "Main", "property": "Length", "operator": "eq", "expected": 4},
        {"type": "assert", "node_path": "Main", "property": "Score", "operator": "eq", "expected": 10},
        {"type": "assert", "node_path": "Main", "property": "FoodsEaten", "operator": "eq", "expected": 1}
     ]}, "note": "the pellet is eaten: the snake grows by exactly one cell and the score moves by 10"},
    {"tag": "g15-readback-growth", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "var m = get_parent()\nreturn \"len=\" + str(m.Length) + \" score=\" + str(m.Score) + \" eaten=\" + str(m.FoodsEaten) + \" \" + m.SegmentsInUse() + \" seg4_in_use=\" + str(m.get_node(\"SnakeSeg04\").InUse)"},
     "note": "the grown snake: one more pool member is in use than before, and it is named"},
    {"tag": "g16-shot-t2-grown", "port": "game", "tool": "running_game_capture_screenshot",
     "arguments": {"save_path": "user://snake-t2.png"}, "note": "the grown snake (pixels must differ from t1)"},

    {"tag": "g17-reversal-refused", "port": "game", "tool": "running_game_run_test_scenario",
     "arguments": {"steps": [
        {"type": "input", "action": "snake_left", "pressed": true},
        {"type": "assert", "node_path": "Main", "property": "DirectionX", "operator": "eq", "expected": 1},
        {"type": "assert", "node_path": "Main", "property": "LastRefusedInput", "operator": "eq", "expected": "-1,0"}
     ]}, "note": "a reversal is refused and recorded instead of obeyed into a self-collision"},

    {"tag": "g18-turn-up", "port": "game", "tool": "running_game_run_test_scenario",
     "arguments": {"steps": [
        {"type": "input", "action": "snake_up", "pressed": true},
        {"type": "assert", "node_path": "Main", "property": "DirectionY", "operator": "eq", "expected": -1}
     ]}, "note": "a legal turn is accepted"},
    {"tag": "g18b-aim-turn-down", "port": "game", "tool": "running_game_execute_gdscript",
     "arguments": {"code": "var m = get_parent()\nreturn m.ForceTestState(\"8,10|7,10|6,10;dir=1,0;food=0,0\")"},
     "note": "test hook (TASK-106, D-1): g19 used to inherit g18's dir=0,-1, so snake_down was a 180-degree reversal that TrySetDirection rightly refused and DirectionY stayed -1. g19 now starts from its own board heading right, where down is a legal turn"},
    {"tag": "g19-turn-down", "port": "game", "tool": "running_game_run_test_scenario",
     "arguments": {"steps": [
        {"type": "input", "action": "snake_down", "pressed": true},
        {"type": "wait", "seconds": 0.4},
        {"type": "assert", "node_path": "Main", "property": "DirectionY", "operator": "eq", "expected": 1}
     ]}, "note": "and the other direction is accepted too (from g18b's own board, so the turn is legal rather than a refusal)"},

